APP_NAME=Userll
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this API. Email verification links are built from it.
APP_URL=http://localhost:8000
# The Next.js site. Used in email links and as the default allowed website for CORS.
FRONTEND_URL=http://localhost:3000
# Websites allowed to call the API from a browser, comma-separated. Falls back to FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. SQLite for local work; use MySQL (or Postgres) in production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=userll
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
# Refunds, payouts and emails are sent by the queue: a worker must be running (php artisan queue:work).
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Email. "log" writes emails to storage/logs. Use a real mail service in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@userll.test"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# Login tokens last this many minutes (default 30 days). 0 means they never expire.
SANCTUM_TOKEN_EXPIRY_MINUTES=43200

# Paystack. Use an sk_test_ key until you go live. Never commit a real key.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Marketplace rules (all amounts in kobo; 100 kobo = ₦1). Defaults are in config/marketplace.php.
MARKETPLACE_COMMISSION_BPS=500
MARKETPLACE_SHIP_WITHIN_HOURS=72
MARKETPLACE_AUTO_RELEASE_DAYS=7
MARKETPLACE_CHECKOUT_EXPIRY_MINUTES=60
MARKETPLACE_MIN_PRICE_KOBO=10000
MARKETPLACE_MAX_PRICE_KOBO=10000000000
MARKETPLACE_MAX_DELIVERY_FEE_KOBO=5000000
MARKETPLACE_MIN_PAYOUT_KOBO=100000
MARKETPLACE_PAYOUT_ACCOUNT_HOLD_HOURS=24
MARKETPLACE_IMAGE_DISK=public

# Identity documents (KYC) are stored privately on this server (storage/app/private) until ALL FOUR of these
# are set. Then they go to Cloudflare R2. Needs: composer require league/flysystem-aws-s3-v3 "^3.0"
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com